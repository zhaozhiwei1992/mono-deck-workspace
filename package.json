{
  "name": "mono-deck-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:base": "pnpm --filter slidev-theme-base dev",
    "dev:tech": "pnpm --filter slidev-theme-tech dev",
    "dev:demo-base": "pnpm --filter deck-demo-base dev",
    "dev:demo-tech": "pnpm --filter deck-demo-tech dev",
    "build:base": "pnpm --filter slidev-theme-base build",
    "build:tech": "pnpm --filter slidev-theme-tech build",
    "dev:all": "pnpm -r --parallel --filter \"./decks/**\" run dev",
    "build:all": "pnpm -r --filter \"./decks/**\" run build",
    "export:all": "pnpm -r --filter \"./decks/**\" run export"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0"
  }
}
